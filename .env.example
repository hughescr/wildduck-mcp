# Optional local port. Never put credentials or key material in this file.
PORT=3000
# Standard WildDuck recognizes plus tags. Enable dot tags only for a verified
# resolver customization, such as the rungie.com fork (default false).
# WILDDUCK_DOT_AS_PLUS=true
# Use registered base identities for automatic reply From (default true).
# Set false to preserve the recognized delivered address, including its tag.
# WILDDUCK_STRIP_REPLY_SUFFIX=true
# Leave unset for safe local smoke checks (readiness/MCP return 503, no AWS calls).
# Production imports its canonical origin from bootstrap; this override is local only.
# PUBLIC_BASE_URL=https://your-canonical-service-origin.example
# CREDENTIAL_TABLE_NAME=wildduck-mcp-prod-state
# AUTH_KEYRING_PARAMETER=/wildduck-mcp/prod/auth-keyring
